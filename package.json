{
  "name": "lifemaxxing-gym",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter mobile run dev",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter api run build && pnpm --filter mobile run build:web",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:migrate:dev": "pnpm --filter api run db:migrate:dev",
    "db:new": "node scripts/db-new.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
