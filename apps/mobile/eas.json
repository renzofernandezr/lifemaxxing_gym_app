{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.3",
      "pnpm": "12.14.0",
      "ios": { "resourceClass": "default" }
    },
    "demo": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_ENV": "demo", "EXPO_PUBLIC_DEMO": "1" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "APP_ENV": "production" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "demo": {},
    "production": {}
  }
}
