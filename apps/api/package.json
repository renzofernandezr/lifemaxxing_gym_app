{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:dev": "tsx --env-file-if-exists=../../.env src/db/migrate.ts --dev",
    "gen:seed": "tsx scripts/gen-seed.ts",
    "gen:sync": "tsx scripts/gen-seed.ts --sync"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@lifemaxxing/core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
